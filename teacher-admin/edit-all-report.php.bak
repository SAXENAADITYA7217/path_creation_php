<style>
    .student-mark-input.is-invalid, 
    #global_max_marks.is-invalid {
        border-color: #dc3545 !important;
        background-color: #fff5f5 !important;
        box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.2) !important;
    }
    .student-mark-input.is-valid {
        border-color: #198754 !important;
    }
    .mark-error-feedback {
        font-size: 0.82rem;
        font-weight: 600;
        color: #dc3545;
        margin-top: 4px;
    }
</style>

<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
function getGlobalMaxMarks() {
    let val = parseFloat($("#global_max_marks").val());
    return isNaN(val) ? 0 : val;
}

function validateStudentMark($input) {
    let globalMax = getGlobalMaxMarks();
    let rawVal = $input.val();
    let $td = $input.closest("td");
    let $feedback = $td.find(".mark-error-feedback");

    if (rawVal === "" || rawVal === null || rawVal === undefined) {
        $input.removeClass("is-invalid is-valid");
        $feedback.hide().empty();
        return true;
    }

    let val = parseFloat(rawVal);
    if (isNaN(val)) {
        $input.addClass("is-invalid").removeClass("is-valid");
        $feedback.html('⚠️ Please enter a valid number.').show();
        return false;
    }

    if (val < 0) {
        $input.addClass("is-invalid").removeClass("is-valid");
        $feedback.html('⚠️ Marks cannot be negative!').show();
        return false;
    } else if (globalMax > 0 && val > globalMax) {
        $input.addClass("is-invalid").removeClass("is-valid");
        $feedback.html('⚠️ Marks (' + val + ') cannot exceed maximum marks (' + globalMax + ')!').show();
        return false;
    } else {
        $input.removeClass("is-invalid").addClass("is-valid");
        $feedback.hide().empty();
        return true;
    }
}

function checkAllScoresValidity() {
    let hasError = false;
    let countErrors = 0;
    let globalMax = getGlobalMaxMarks();

    if (isNaN(globalMax) || globalMax <= 0) {
        hasError = true;
    }

    $(".student-mark-input").each(function () {
        let isValid = validateStudentMark($(this));
        if (!isValid) {
            hasError = true;
            countErrors++;
        }
    });

    if (hasError) {
        if (countErrors > 0) {
            $("#markValidationAlertText").html("<strong>Error:</strong> " + countErrors + " score(s) exceed maximum marks (<strong>" + globalMax + "</strong>) or have invalid values. Please correct them before saving.");
        } else {
            $("#markValidationAlertText").html("<strong>Error:</strong> Please enter a valid Maximum Marks greater than 0.");
        }
        $("#markValidationAlert").removeClass("d-none alert-warning").addClass("alert-danger");
        $("#updateAllMarksBtn").addClass("btn-danger").removeClass("btn-success");
    } else {
        $("#markValidationAlert").addClass("d-none");
        $("#updateAllMarksBtn").addClass("btn-success").removeClass("btn-danger");
    }

    return !hasError;
}

function syncGlobalMaxMarks() {
    let globalMax = getGlobalMaxMarks();
    let $globalInput = $("#global_max_marks");
    let $globalFeedback = $("#globalMaxFeedback");

    if (globalMax <= 0 || isNaN(globalMax)) {
        $globalInput.addClass("is-invalid");
        $globalFeedback.html('⚠️ Maximum marks must be greater than 0!').show();
        return;
    } else {
        $globalInput.removeClass("is-invalid");
        $globalFeedback.hide().empty();
    }

    // Reflect to all table badges and hidden inputs
    $(".max-mark-badge").text(globalMax);
    $(".row-total-marks").val(globalMax);
    $(".student-mark-input").attr("max", globalMax);

    let adjustedCount = 0;

    // If max marks is reduced, automatically update each student's mark to remove the violation!
    $(".student-mark-input").each(function () {
        let $input = $(this);
        let currentVal = parseFloat($input.val());
        let $td = $input.closest("td");
        let $adjustedBadge = $td.find(".adjusted-badge");

        if (!isNaN(currentVal) && currentVal > globalMax) {
            $input.val(globalMax);
            $input.removeClass("is-invalid").addClass("is-valid");
            $td.find(".mark-error-feedback").hide().empty();

            $adjustedBadge.html('<i class="fas fa-exclamation-triangle me-1"></i> Auto-updated from ' + currentVal + ' to ' + globalMax + ' (max limit)').show();
            adjustedCount++;
        } else {
            validateStudentMark($input);
        }
    });

    if (adjustedCount > 0) {
        $("#markValidationAlertText").html("<strong>Notice:</strong> Maximum marks updated to <strong>" + globalMax + "</strong>. " + adjustedCount + " student mark(s) exceeded " + globalMax + " and were automatically updated to " + globalMax + " to remove violations. You can edit individual marks below.");
        $("#markValidationAlert").removeClass("d-none alert-danger").addClass("alert-warning");
    }

    checkAllScoresValidity();
}

$(document).on("input keyup change paste", ".student-mark-input", function () {
    let $input = $(this);
    $input.closest("td").find(".adjusted-badge").fadeOut();
    validateStudentMark($input);
    checkAllScoresValidity();
});

$("#global_max_marks").on("input keyup change paste", function () {
    syncGlobalMaxMarks();
});

$(document).ready(function () {
    syncGlobalMaxMarks();
});

$("#editAllReportForm").on("submit", function (e) {
    let globalMax = getGlobalMaxMarks();
    if (isNaN(globalMax) || globalMax <= 0) {
        e.preventDefault();
        $("#global_max_marks").focus();
        alert("Please enter a valid Maximum Marks greater than 0.");
        return false;
    }

    let allValid = checkAllScoresValidity();
    if (!allValid) {
        e.preventDefault();
        let $firstError = $(".student-mark-input.is-invalid").first();
        if ($firstError.length > 0) {
            $('html, body').animate({
                scrollTop: $firstError.offset().top - 140
            }, 300);
            $firstError.focus();
        }
        alert("Cannot save changes! Some marks exceed maximum marks (" + globalMax + "). Please fix the highlighted errors.");
        return false;
    }
});
</script>

