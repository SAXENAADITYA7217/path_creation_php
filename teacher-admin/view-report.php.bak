                            <?php
                            foreach($exam_types as $code => $map) {
                                $selected = ($selected_exam == $code) ? 'selected' : '';
                                echo "<option value='{$code}' {$selected}>{$map['name']}</option>";
                            }
                            ?>
                        </select>
