            <div id="reportContainer">
                <?php
                if(!empty($selected_class) && !empty($selected_exam) && !empty($selected_subject)) {

                    $exam_type_int = $exam_types[$selected_exam]['code'] ?? 0;
                    $subject = mysqli_real_escape_string($con, $selected_subject);

                    // --- Fetch all students for this teacher only ---
                    $query_all = "
                        SELECT s.rollno, s.fname, s.lname, s.id AS student_id,
                               SUM(ss.marks_obtained) AS total_obtained,
                               SUM(ss.total_marks) AS grand_total,
                               (SUM(ss.marks_obtained)/SUM(ss.total_marks)*100) AS percentage
                        FROM users s
                        JOIN student_score ss ON s.id = ss.student_id
                        WHERE s.role_as='0' 
                          AND s.class='$selected_class'
                          AND ss.class_code='$selected_class'
                          AND ss.test_code='$exam_type_int'
                          AND ss.subject='$subject'
                          AND ss.teacher_id='$teacher_id'
                        GROUP BY s.id
                        ORDER BY s.rollno ASC
                    ";

                    $result_all = mysqli_query($con, $query_all);

                    $query_top3 = "
                        SELECT s.fname, s.lname, 
                               (SUM(ss.marks_obtained)/SUM(ss.total_marks)*100) AS percentage
                        FROM users s
                        JOIN student_score ss ON s.id = ss.student_id
                        WHERE s.role_as='0' 
                          AND s.class='$selected_class'
                          AND ss.class_code='$selected_class'
                          AND ss.test_code='$exam_type_int'
                          AND ss.subject='$subject'
                          AND ss.teacher_id='$teacher_id'
                        GROUP BY s.id
                        ORDER BY percentage DESC
                        LIMIT 3
                    ";
                    $result_top3 = mysqli_query($con, $query_top3);

                    $class_display = $full_class_options[$selected_class] ?? 'Class ' . $selected_class;
                    $exam_display = $exam_types[$selected_exam]['name'] ?? $selected_exam;

                    // --- TOP 3 PERFORMERS BOX ---
                    if($result_top3 && mysqli_num_rows($result_top3) > 0):
                ?>
                    <div class="top-performers-wrap">
                        <div class="top-performers-title">
                            <i class="fa-solid fa-trophy text-warning"></i>
                            <span>Top 3 Performers in <strong><?= htmlspecialchars($subject) ?></strong> &bull; <?= htmlspecialchars($exam_display) ?></span>
                        </div>
                        <div class="top-performers-grid">
                            <?php
                            $rank = 1;
                            $rank_icons = [1 => 'fa-trophy', 2 => 'fa-medal', 3 => 'fa-award'];
                            while($top_row = mysqli_fetch_assoc($result_top3)):
                                $student_name = htmlspecialchars(trim($top_row['fname'].' '.$top_row['lname']));
                                $percentage = number_format($top_row['percentage'], 2).'%';
                                $cur_icon = $rank_icons[$rank] ?? 'fa-award';
                            ?>
                            <div class="rank-card rank-card-<?= $rank ?>">
                                <div class="rank-badge">
                                    <i class="fa-solid <?= $cur_icon ?> mb-1"></i>
                                    <span>#<?= $rank ?></span>
                                </div>
                                <div class="rank-info">
                                    <div class="rank-student-name" title="<?= $student_name ?>"><?= $student_name ?></div>
                                    <span class="rank-score-pill"><?= $percentage ?></span>
                                </div>
                            </div>
                            <?php 
                                $rank++;
                            endwhile; 
                            ?>
                        </div>
                    </div>
                <?php endif; ?>

                <!-- --- FULL STUDENT TABLE --- -->
                <?php if($result_all && mysqli_num_rows($result_all) > 0): ?>
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                        <div>
                            <h6 class="mb-0 fw-bold text-dark" style="font-size: 0.98rem;">
                                <i class="fa-solid fa-table-list text-primary me-2"></i>Students Score Sheet
                            </h6>
                            <span class="text-muted" style="font-size: 0.8rem;">
                                <?= htmlspecialchars($class_display) ?> &bull; <?= htmlspecialchars($subject) ?> &bull; <?= htmlspecialchars($exam_display) ?>
                            </span>
                        </div>
                        <a href="edit-all-report.php?class_code=<?= urlencode($selected_class) ?>&exam_type=<?= urlencode($selected_exam) ?>&subject=<?= urlencode($subject) ?>" class="btn-secondary-action">
                            <i class="fas fa-sliders-h"></i> Update Maximum Marks & All Scores
                        </a>
                    </div>

                    <div class="table-responsive">
                        <table class="pca-table">
                            <colgroup>
                                <col style="width: 12%;">
                                <col style="width: 32%;">
                                <col style="width: 18%;">
                                <col style="width: 14%;">
                                <col style="width: 12%;">
                                <col style="width: 12%;">
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>Roll No</th>
                                    <th>Student Name</th>
                                    <th>Total Obtained</th>
                                    <th>Grand Total</th>
                                    <th>Percentage</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <?php 
                                $palette = [
                                    ['bg' => '#eef2ff', 'color' => '#4338ca'],
                                    ['bg' => '#ecfdf5', 'color' => '#047857'],
                                    ['bg' => '#fef3c7', 'color' => '#b45309'],
                                    ['bg' => '#fdf2f8', 'color' => '#be185d'],
                                    ['bg' => '#f0f9ff', 'color' => '#0369a1'],
                                ];

                                while($row = mysqli_fetch_assoc($result_all)):
                                    $student_name = htmlspecialchars(trim($row['fname'].' '.$row['lname']));
                                    $total_obtained = $row['total_obtained'];
                                    $grand_total = $row['grand_total'];
                                    $percentage_val = (float)$row['percentage'];
                                    $percentage_str = number_format($percentage_val, 2).'%';
                                    $student_id = $row['student_id'];

                                    $pal_idx = abs(crc32($student_id . $student_name)) % count($palette);
                                    $avatar = $palette[$pal_idx];
                                    $initial = strtoupper(substr($row['fname'], 0, 1));

                                    $pill_class = 'score-pill-high';
                                    if($percentage_val < 50) {
                                        $pill_class = 'score-pill-low';
                                    } elseif($percentage_val < 75) {
                                        $pill_class = 'score-pill-mid';
                                    }
                                ?>
                                <tr>
                                    <td>
                                        <span class="badge-roll-pill">#<?= htmlspecialchars($row['rollno']) ?></span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="student-avatar-circle" style="background: <?= $avatar['bg'] ?>; color: <?= $avatar['color'] ?>;">
                                                <?= $initial ?>
                                            </div>
                                            <span class="fw-semibold text-dark" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                                <?= $student_name ?>
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-dark"><?= htmlspecialchars($total_obtained) ?></span>
                                    </td>
                                    <td>
                                        <span class="text-muted fw-semibold"><?= htmlspecialchars($grand_total) ?></span>
                                    </td>
                                    <td>
                                        <span class="score-pill <?= $pill_class ?>"><?= $percentage_str ?></span>
                                    </td>
                                    <td class="text-end">
                                        <a href="edit-report.php?student_id=<?= $student_id ?>&class_code=<?= urlencode($selected_class) ?>&exam_type=<?= urlencode($selected_exam) ?>&subject=<?= urlencode($subject) ?>" class="btn-table-action">
                                            <i class="fas fa-user-edit"></i> Edit
                                        </a>
                                    </td>
                                </tr>
                                <?php endwhile; ?>
                            </tbody>
                        </table>
                    </div>
                <?php else: ?>
                    <div class="empty-state-clean text-center">
                        <div class="empty-icon-circle mx-auto mb-3">
                            <i class="fa-solid fa-clipboard-question text-muted fa-lg"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-1">No student scores found</h6>
                        <p class="text-muted mb-3" style="font-size: 0.85rem;">No theory marks have been added for this class, subject, and exam selection.</p>
                        <a href="add-report.php" class="btn-primary-action btn-sm">
                            <i class="fas fa-plus"></i> Add Theory Marks
                        </a>
                    </div>
                <?php endif; ?>
                <?php } else { ?>
                    <div class="empty-state-clean text-center">
                        <div class="empty-icon-circle mx-auto mb-3">
                            <i class="fa-solid fa-filter text-primary fa-lg"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-1">Select Report Parameters</h6>
                        <p class="text-muted mb-0" style="font-size: 0.85rem;">Please select a Class, Subject, and Test Type above and click "Show Report" to view performance.</p>
                    </div>
                <?php } ?>
            </div>

        </div>
    </div>
</div>

<!-- jQuery for subject auto-load -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
$(window).on('load', function() {
    console.log("Page fully loaded... initializing subject loader.");

    function loadSubjects(selected_class, preSelect='') {
        let $subjectSelect = $("#subject");
        console.log("Loading subjects for class:", selected_class);

        if(selected_class) {
            $subjectSelect.html('<option value="">Loading subjects...</option>');
            $.ajax({
                url: "teacher_code.php",
                type: "POST",
                data: { action: "load_subjects", class_code: selected_class },
                success: function (response) {
                    console.log("Subjects loaded:", response);
                    $subjectSelect.html(response);
                    if(preSelect) {
                        $subjectSelect.val(preSelect);
                        console.log("Preselected subject:", preSelect);
                    }
                },
                error: function () {
                    console.error("AJAX error loading subjects");
                    $subjectSelect.html('<option value="">-- Error Loading Subjects --</option>');
                }
            });
        } else {
            $subjectSelect.html('<option value="">-- Select Class First --</option>');
        }
    }

    let preSelectedClass = "<?= addslashes($selected_class) ?>";
    let preSelectedSubject = "<?= addslashes($selected_subject) ?>";

    $("#class_code").on("change", function() {
        let cls = $(this).val();
        loadSubjects(cls);
    });

    if(preSelectedClass) {
        loadSubjects(preSelectedClass, preSelectedSubject);
    }
});
</script>

<?php
include('includes/footer.php');
include('includes/scripts.php');
?>
