<?php
include('authentication.php');
include('includes/header.php');

// --- Exam Types & Class Mapping ---
$exam_types = [
    'unit_test_1' => ['name' => 'Unit Test 1', 'code' => 1],
    'unit_test_2' => ['name' => 'Unit Test 2', 'code' => 2],
    'unit_test_3' => ['name' => 'Unit Test 3', 'code' => 3],
    'unit_test_4' => ['name' => 'Unit Test 4', 'code' => 4],
    'half_year'   => ['name' => 'Half Year Exam', 'code' => 5],
    'final'       => ['name' => 'Final Exam', 'code' => 6],
    'class_test'  => ['name' => 'Class Test', 'code' => 7]
];

$full_class_options = [
    '100' => 'Nursery',
    '101' => 'LKG',
    '102' => 'UKG',
    '1' => 'Class 1',
    '2' => 'Class 2',
    '3' => 'Class 3',
    '4' => 'Class 4',
    '5' => 'Class 5',
    '6' => 'Class 6',
    '7' => 'Class 7',
    '8' => 'Class 8',
    '9' => 'Class 9',
    '10' => 'Class 10',
    '11' => 'Class 11 Sci (PCB)',
    '12' => 'Class 11 Sci (PCM)',
    '13' => 'Class 11 Comm. (with Math)',
    '14' => 'Class 11 Comm. (without Math)',
    '15' => 'Class 11 Arts',
    '16' => 'Class 12 Sci (PCB)',
    '17' => 'Class 12 Sci (PCM)',
    '18' => 'Class 12 Comm. (with Math)',
    '19' => 'Class 12 Comm. (without Math)',
    '20' => 'Class 12 Arts'
];

// --- Current teacher ---
$teacher_id = $_SESSION['auth_user']['user_id'] ?? $_SESSION['auth_user']['id'] ?? '';

// --- Detect filters from GET or last added marks ---
$selected_class = $_GET['class_code'] ?? '';
$selected_exam  = $_GET['exam_type'] ?? '';
$selected_subject = $_GET['subject'] ?? '';

if(empty($selected_class) || empty($selected_exam) || empty($selected_subject)) {
    // Get last added marks entry by this teacher
    $last_entry_q = "SELECT class_code, test_code, subject 
                     FROM student_score 
                     WHERE teacher_id='$teacher_id'
                     ORDER BY id DESC LIMIT 1";
    $last_result = mysqli_query($con, $last_entry_q);
    if($last_result && mysqli_num_rows($last_result) > 0){
        $last_row = mysqli_fetch_assoc($last_result);
        if(empty($selected_class)) $selected_class = $last_row['class_code'];
        if(empty($selected_exam)) {
            $last_test_code = $last_row['test_code'];
            foreach($exam_types as $key => $map){
                if($map['code'] == $last_test_code){
                    $selected_exam = $key;
                    break;
                }
            }
        }
        if(empty($selected_subject)) $selected_subject = $last_row['subject'];
    }
}
?>

