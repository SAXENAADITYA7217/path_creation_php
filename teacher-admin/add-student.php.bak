<script>
// Add new row on click
document.getElementById('addRow').addEventListener('click', function () {
    let container = document.getElementById('studentFields');
    let firstRow = container.querySelector('.student-row');
    let newRow = firstRow.cloneNode(true);

    // Clear input values
    newRow.querySelectorAll('input').forEach(input => input.value = "");

    container.appendChild(newRow);

    // Attach remove event to new row button
    attachRemoveEvents();
});

// Function to attach remove button click
function attachRemoveEvents() {
    document.querySelectorAll('.removeRow').forEach(btn => {
        btn.onclick = function () {
            let allRows = document.querySelectorAll('.student-row');
            if (allRows.length > 1) {
                this.closest('.student-row').remove();
            } else {
                alert("You must have at least one student row.");
            }
        }
    });
}

// Attach remove event initially
attachRemoveEvents();
</script>

