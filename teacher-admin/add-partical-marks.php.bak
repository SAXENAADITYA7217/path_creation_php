<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
function getMaxPractical() {
    let max = parseFloat($("#hidden_total_practical").val());
    if (isNaN(max) || max <= 0) {
        max = parseFloat($("#total_practical").val());
    }
    return isNaN(max) ? 0 : max;
}

function applyMaxPractical(maxPractical){
    $("#studentsContainer .student-practical-mark-input").attr('max', maxPractical);
}

function validateSinglePracticalInput($input) {
    let maxPractical = getMaxPractical();
    let rawVal = $input.val();
    let $td = $input.closest("td");
    let $feedback = $td.find(".mark-error-feedback");

    if ($feedback.length === 0) {
        $feedback = $('<div class="mark-error-feedback" style="display:none;"></div>');
        $input.after($feedback);
    }

    if (rawVal === "" || rawVal === null || rawVal === undefined) {
        $input.removeClass("is-invalid");
        $feedback.hide().empty();
        return true;
    }

    let val = parseFloat(rawVal);
    if (isNaN(val)) {
        $input.addClass("is-invalid");
        $feedback.html('⚠️ Please enter a valid number.').show();
        return false;
    }

    if (maxPractical > 0 && val > maxPractical) {
        $input.addClass("is-invalid");
        $feedback.html('⚠️ Marks (' + val + ') cannot exceed maximum practical marks (' + maxPractical + ')!').show();
        return false;
    } else if (val < 0) {
        $input.addClass("is-invalid");
        $feedback.html('⚠️ Marks cannot be negative!').show();
        return false;
    } else {
        $input.removeClass("is-invalid");
        $feedback.hide().empty();
        return true;
    }
}

function checkAllPracticalMarksValidity() {
    let hasError = false;
    let countErrors = 0;
    let maxPractical = getMaxPractical();

    $("#studentsContainer .student-practical-mark-input").each(function () {
        let isValid = validateSinglePracticalInput($(this));
        if (!isValid) {
            hasError = true;
            countErrors++;
        }
    });

    if (hasError) {
        $("#practicalValidationAlertText").html("<strong>Error:</strong> " + countErrors + " student(s) have marks exceeding maximum practical marks (<strong>" + maxPractical + "</strong>) or negative values. Please correct them before saving.");
        $("#practicalValidationAlert").removeClass("d-none");
        $("#savePracticalBtn").addClass("btn-has-error");
    } else {
        $("#practicalValidationAlert").addClass("d-none");
        $("#savePracticalBtn").removeClass("btn-has-error");
    }

    return !hasError;
}

// Real-time validation as the teacher types, changes or pastes practical marks
$(document).on("input keyup change paste", ".student-practical-mark-input", function () {
    validateSinglePracticalInput($(this));
    checkAllPracticalMarksValidity();
});

// Re-validate if the Total Practical Marks input is edited in the top form
$("#total_practical").on("input change", function () {
    let newMax = parseFloat($(this).val());
    if (!isNaN(newMax) && newMax > 0) {
        $("#hidden_total_practical").val(newMax);
        applyMaxPractical(newMax);
        checkAllPracticalMarksValidity();
    }
});

// Prevent submission if any practical mark exceeds max marks or is negative
$("#practicalMarksForm").on("submit", function (e) {
    let allValid = checkAllPracticalMarksValidity();
    if (!allValid) {
        e.preventDefault();
        let $firstError = $("#studentsContainer .student-practical-mark-input.is-invalid").first();
        if ($firstError.length > 0) {
            $('html, body').animate({
                scrollTop: $firstError.offset().top - 120
            }, 300);
            $firstError.focus();
        }
        alert("Cannot save! Some student marks exceed the maximum practical marks of " + getMaxPractical() + ". Please correct the highlighted errors.");
        return false;
    }
});

// Load available subjects dynamically (excluding already uploaded practical subjects for selected exam)
function refreshAvailableSubjects() {
    let class_code = $("#class_code").val();
    let exam_type = $("#exam_type").val();
    let $subjectSelect = $("#subject");
    let $notice = $("#allPracticalSubmittedNotice");

    // Clear loaded students table when class or exam changes
    $("#studentsContainer").empty();
    $("#practicalValidationAlert").addClass("d-none");
    $notice.addClass("d-none");

    if (!class_code && !exam_type) {
        $subjectSelect.html('<option value="">-- Select Class & Exam First --</option>').prop('disabled', true);
        $("#loadStudentsBtn").prop('disabled', false);
        return;
    }

    if (!class_code) {
        $subjectSelect.html('<option value="">-- Select Class First --</option>').prop('disabled', true);
        $("#loadStudentsBtn").prop('disabled', false);
        return;
    }

    if (!exam_type) {
        $subjectSelect.html('<option value="">-- Select Exam Type First --</option>').prop('disabled', true);
        $("#loadStudentsBtn").prop('disabled', false);
        return;
    }

    $subjectSelect.html('<option value="">Loading available subjects...</option>').prop('disabled', true);

    $.ajax({
        url: "teacher_code.php",
        type: "POST",
        data: {
            action: "load_subjects",
            class_code: class_code,
            exam_type: exam_type,
            mark_type: "practical",
            filter_submitted: 1
        },
        success: function (response) {
            $subjectSelect.html(response);

            let hasValidOptions = false;
            $subjectSelect.find('option').each(function () {
                let val = $(this).val();
                if (val !== "") {
                    hasValidOptions = true;
                }
            });

            if (hasValidOptions) {
                $subjectSelect.prop('disabled', false);
                $("#loadStudentsBtn").prop('disabled', false);
                $notice.addClass("d-none");
            } else {
                $subjectSelect.prop('disabled', true);
                $("#loadStudentsBtn").prop('disabled', true);
                $("#viewExistingPracticalMarksLink").attr("href", "view-partical-marks.php?class_code=" + encodeURIComponent(class_code) + "&exam_type=" + encodeURIComponent(exam_type));
                $notice.removeClass("d-none");
            }
        },
        error: function () {
            $subjectSelect.html('<option value="">-- Error Loading Subjects --</option>').prop('disabled', true);
        }
    });
}

$("#class_code, #exam_type").on("change", function () {
    refreshAvailableSubjects();
});

$("#subject").on("change", function () {
    $("#studentsContainer").empty();
    $("#practicalValidationAlert").addClass("d-none");
});

// Load students for practical marks
$("#loadStudentsBtn").on("click", function(){
    let class_code = $("#class_code").val();
    let exam_type = $("#exam_type").val();
    let subject = $("#subject").val();
    let total_practical = parseFloat($("#total_practical").val());

    if(!class_code || !exam_type || !subject || isNaN(total_practical) || total_practical <= 0){
        alert("Please select Class, Exam Type, Subject, and enter a valid Total Practical Marks greater than 0!");
        return;
    }

    $("#hidden_class").val(class_code);
    $("#hidden_subject").val(subject);
    $("#hidden_exam_type").val(exam_type);
    $("#hidden_total_practical").val(total_practical);

    $.ajax({
        url:"teacher_code.php",
        type:"POST",
        data:{action:"load_students_practical", class_code:class_code},
        success:function(response){
            $("#studentsContainer").html(response);
            applyMaxPractical(total_practical);
            checkAllPracticalMarksValidity();
        },
        error: function() {
            alert("Error: Could not connect to the server or load data.");
        }
    });
});
</script>

