<?php
// report_card_select.php (Main Class Selection Page)
include('authentication.php');
include('includes/header.php');

// Teacher's default class from session
$teacher_class = isset($_SESSION['auth_user']['user_class']) ? $_SESSION['auth_user']['user_class'] : '';

// Define class options
$full_class_options = [
    '100' => 'Nursery',
    '101' => 'LKG',
    '102' => 'UKG',
    '1' => 'Class 1',
    '2' => 'Class 2',
    '3' => 'Class 3',
    '4' => 'Class 4',
    '5' => 'Class 5',
    '6' => 'Class 6',
    '7' => 'Class 7',
    '8' => 'Class 8',
    '9' => 'Class 9',
    '10' => 'Class 10',
    '11' => 'Class 11 Sci (PCB)',
    '12' => 'Class 11 Sci (PCM)',
    '13' => 'Class 11 Comm. (with Math)',
    '14' => 'Class 11 Comm. (without Math)',
    '15' => 'Class 11 Arts',
    '16' => 'Class 12 Sci (PCB)',
    '17' => 'Class 12 Sci (PCM)',
    '18' => 'Class 12 Comm. (with Math)',
    '19' => 'Class 12 Comm. (without Math)',
    '20' => 'Class 12 Arts'
];
?>

<div class="container mt-4">
    <h2>Generate Student Report Card</h2>
    <div class="row mb-3">
        <div class="col-md-4">
            <label>Select Class:</label>
            <select id="class_select" class="form-control">
                <option value="">--Select Class--</option>
                <?php foreach($full_class_options as $id => $name): ?>
                    <option value="<?= $id ?>" <?= ($teacher_class == $id) ? 'selected' : '' ?>>
                        <?= $name ?>
                    </option>
                <?php endforeach; ?>
            </select>
        </div>
    </div>

    <div id="student_list" class="mt-4"></div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
$(document).ready(function(){

    // Auto-load students for teacher's default class if preselected
    let defaultClass = $('#class_select').val();
    if(defaultClass){
        loadStudents(defaultClass);
    }

    // Load students when class is changed
    $('#class_select').change(function(){
        let class_id = $(this).val();
        if(class_id){
            loadStudents(class_id);
        } else {
            $('#student_list').html('');
        }
    });

    function loadStudents(class_id){
        $('#student_list').html('<p class="text-info">Loading students...</p>');
        $.ajax({
            url: 'fetch_students_list.php',
            type: 'POST',
            data: {class_id: class_id},
            success: function(data){
                $('#student_list').html(data);
            },
            error: function(){
                $('#student_list').html('<p class="text-danger">Error loading students.</p>');
            }
        });
    }

});
</script>

<?php
include('includes/footer.php');
include('includes/scripts.php');
