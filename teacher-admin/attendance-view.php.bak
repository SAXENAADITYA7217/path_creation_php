<?php
include('authentication.php');
include('includes/header.php');
include('includes/fetch_class.php');

// CLASS MAPPING
$classMapping = [
    '100' => 'Nursery', '101' => 'LKG', '102' => 'UKG',
    '1' => 'Class 1', '2' => 'Class 2', '3' => 'Class 3', '4' => 'Class 4', '5' => 'Class 5',
    '6' => 'Class 6', '7' => 'Class 7', '8' => 'Class 8', '9' => 'Class 9', '10' => 'Class 10',
    '11' => 'Class 11 Sci (PCB)', '12' => 'Class 11 Sci (PCM)',
    '13' => 'Class 11 Comm. (with Math)', '14' => 'Class 11 Comm. (without Math)',
    '15' => 'Class 11 Arts',
    '16' => 'Class 12 Sci (PCB)', '17' => 'Class 12 Sci (PCM)',
    '18' => 'Class 12 Comm. (with Math)', '19' => 'Class 12 Comm. (without Math)',
    '20' => 'Class 12 Arts'
];

$user_id = $_SESSION['auth_user']['id'];
$query_class = "SELECT class FROM class_teacher WHERE user_id='$user_id'";
$result = mysqli_query($con, $query_class);

$classes = [];
while($row = mysqli_fetch_assoc($result)) {
    $classes[] = $row['class'];
}

if(empty($classes)) {
    echo "<div class='container mt-5'><h5 class='text-danger'>No class assigned to you.</h5></div>";
    include('includes/footer.php');
    exit;
}

$selectedClass = $_GET['class'] ?? $_SESSION['teacher_selected_class'] ?? (!empty($classes) ? $classes[0] : '');
if (!in_array($selectedClass, $classes) && !empty($classes)) {
    $selectedClass = $classes[0];
}
$_SESSION['teacher_selected_class'] = $selectedClass;
$selectedStudent = $_GET['student'] ?? '';

$current_date = date('Y-m-d');
$selectedDate = $_GET['date'] ?? $current_date;

// Fetch all students of class
$studentsQuery = "SELECT * FROM users WHERE class='$selectedClass' AND role_as=0 ORDER BY rollno ASC";
$studentsResult = mysqli_query($con, $studentsQuery);
?>

<div class="container-fluid px-4">
    <div class="row mt-4">
        <div class="col-md-12">

            <?php include('message.php'); ?>

            <div class="card">
                <div class="card-header d-flex justify-content-between">
                    <h4>Attendance View</h4>
                    <a href="attendance-add.php<?= !empty($selectedClass) ? '?class=' . urlencode($selectedClass) : '' ?>" class="btn btn-primary">Add Attendance</a>
                </div>

                <div class="card-body">

                    <!-- FILTER FORM -->
                    <form method="GET" class="row g-3 mb-4">
                        <div class="col-md-3">
                            <label>Select Class:</label>
                            <select name="class" class="form-control" onchange="this.form.submit()">
                                <?php
                                foreach($classes as $c){
                                    $selected = ($selectedClass == $c) ? 'selected' : '';
                                    echo "<option value='$c' $selected>{$classMapping[$c]}</option>";
                                }
                                ?>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label>Select Student:</label>
                            <select name="student" class="form-control">
                                <option value="">-- All Students --</option>
                                <?php
                                mysqli_data_seek($studentsResult, 0);
                                while($stu = mysqli_fetch_assoc($studentsResult)){
                                    $sel = ($selectedStudent == $stu['id']) ? 'selected' : '';
                                    echo "<option value='{$stu['id']}' $sel>{$stu['fname']} {$stu['lname']}</option>";
                                }
                                ?>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label>Select Date:</label>
                            <input type="date" name="date" class="form-control" value="<?= $selectedDate ?>">
                        </div>

                        <div class="col-md-12 d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary">Show Attendance</button>
                        </div>
                    </form>

                    <?php
                    // MAIN ATTENDANCE FETCH
                    $attendanceQuery = "SELECT a.*, u.fname, u.lname, u.rollno 
                                        FROM attendance a
                                        JOIN users u ON a.user_id = u.id
                                        WHERE u.class='$selectedClass'";

                    if(!empty($selectedStudent)) 
                        $attendanceQuery .= " AND u.id='$selectedStudent'";

                    // Only single date
                    $attendanceQuery .= " AND a.date = '$selectedDate'";

                    $attendanceQuery .= " ORDER BY a.date DESC";

                    $attendanceResult = mysqli_query($con, $attendanceQuery);

                    if(mysqli_num_rows($attendanceResult) > 0){

                        echo "<div class='table-responsive'>";
                        echo "<table class='table table-bordered table-striped'>";
                        echo "<thead><tr>
                                <th>Roll No</th>
                                <th>Name</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Update</th>
                              </tr></thead><tbody>";

                        while($att = mysqli_fetch_assoc($attendanceResult)){
                            $statusLabel = ($att['status']==1?'Present':($att['status']==0?'Absent':'Holiday'));
                            $color = ($att['status']==1?'green':($att['status']==0?'red':'blue'));

                            echo "<tr>
                                    <td>{$att['rollno']}</td>
                                    <td>{$att['fname']} {$att['lname']}</td>
                                    <td>{$att['date']}</td>
                                    <td style='color:$color;font-weight:bold'>$statusLabel</td>
                                    <td>
                                        <form method='POST' action='teacher_code.php' class='d-flex gap-2'>
                                            <input type='hidden' name='attendance_id' value='{$att['id']}'>
                                            <input type='hidden' name='class' value='{$selectedClass}'>
                                            <input type='hidden' name='student' value='{$selectedStudent}'>
                                            <input type='hidden' name='date' value='{$selectedDate}'>

                                            <select name='status' class='form-select form-select-sm w-auto'>
                                                <option value='1' ".($att['status']==1?'selected':'').">Present</option>
                                                <option value='0' ".($att['status']==0?'selected':'').">Absent</option>
                                                <option value='2' ".($att['status']==2?'selected':'').">Holiday</option>
                                            </select>

                                            <button type='submit' name='update_attendance' class='btn btn-sm btn-success'>Update</button>
                                        </form>
                                    </td>
                                  </tr>";
                        }

                        echo "</tbody></table></div>";

                    } else {
                        echo "<p>No attendance records found for this date.</p>";
                    }
                    ?>

                    <div class="mt-3">
                         <a href="attendence-percentage.php" class="btn btn-success btn-lg">
                            View Overall Student Percentage
                         </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<?php
include('includes/footer.php');
include('includes/scripts.php');
?>
