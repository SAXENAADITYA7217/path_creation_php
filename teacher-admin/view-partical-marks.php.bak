            <div id="reportContainer">
                <?php
                if(!empty($selected_class) && !empty($selected_exam) && !empty($selected_subject)) {
                    $exam_type_int = $exam_types[$selected_exam]['code'] ?? 0;
                    $subject_safe = mysqli_real_escape_string($con, $selected_subject);

                    $query = "
                        SELECT ss.id AS score_id, ss.student_id, ss.practical_marks, ss.total_practical,
                               u.fname, u.lname, u.rollno
                        FROM student_score ss
                        JOIN users u ON ss.student_id = u.id
                        WHERE ss.teacher_id = '$teacher_id'
                          AND ss.class_code='$selected_class'
                          AND ss.subject='$subject_safe'
                          AND ss.test_code='$exam_type_int'
                          AND ss.practical_marks >= 0
                        ORDER BY u.rollno ASC
                    ";
                    $result = mysqli_query($con, $query);

                    $class_display = $full_class_options[$selected_class] ?? 'Class ' . $selected_class;
                    $exam_display = $exam_types[$selected_exam]['name'] ?? $selected_exam;

                    if($result && mysqli_num_rows($result) > 0):
                ?>
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                        <div>
                            <h6 class="mb-0 fw-bold text-dark" style="font-size: 0.98rem;">
