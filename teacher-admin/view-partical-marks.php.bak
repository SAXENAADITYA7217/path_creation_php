                                ];

                                while($row = mysqli_fetch_assoc($result)): 
                                    $student_name = htmlspecialchars(trim($row['fname'].' '.$row['lname']));
                                    $pal_idx = abs(crc32($row['student_id'] . $student_name)) % count($palette);
                                    $avatar = $palette[$pal_idx];
                                    $initial = strtoupper(substr($row['fname'], 0, 1));
                                ?>
                                <tr>
