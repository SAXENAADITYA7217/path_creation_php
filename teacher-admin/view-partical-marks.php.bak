<?php
include('authentication.php');
include('includes/header.php');

// --- Exam Types ---
$exam_types = [
    'unit_test_1' => ['name' => 'Unit Test 1', 'code' => 1],
    'unit_test_2' => ['name' => 'Unit Test 2', 'code' => 2],
    'unit_test_3' => ['name' => 'Unit Test 3', 'code' => 3],
    'unit_test_4' => ['name' => 'Unit Test 4', 'code' => 4],
    'half_year'   => ['name' => 'Half Year Exam', 'code' => 5],
    'final'       => ['name' => 'Final Exam', 'code' => 6],
    'class_test'  => ['name' => 'Class Test', 'code' => 7]
];

// --- Class Mapping ---
$full_class_options = [
    '100' => 'Nursery',
    '101' => 'LKG',
    '102' => 'UKG',
    '1' => 'Class 1',
    '2' => 'Class 2',
    '3' => 'Class 3',
    '4' => 'Class 4',
    '5' => 'Class 5',
    '6' => 'Class 6',
    '7' => 'Class 7',
    '8' => 'Class 8',
    '9' => 'Class 9',
    '10' => 'Class 10',
    '11' => 'Class 11 Sci (PCB)',
    '12' => 'Class 11 Sci (PCM)',
    '13' => 'Class 11 Comm. (with Math)',
    '14' => 'Class 11 Comm. (without Math)',
    '15' => 'Class 11 Arts',
    '16' => 'Class 12 Sci (PCB)',
    '17' => 'Class 12 Sci (PCM)',
    '18' => 'Class 12 Comm. (with Math)',
    '19' => 'Class 12 Comm. (without Math)',
    '20' => 'Class 12 Arts'
];

// --- Current Teacher ---
$teacher_id = $_SESSION['auth_user']['user_id'] ?? $_SESSION['auth_user']['id'] ?? '';

// --- Detect Filters ---
$selected_class = $_GET['class_code'] ?? '';
$selected_exam  = $_GET['exam_type'] ?? '';
$selected_subject = $_GET['subject'] ?? '';

// --- If no filter selected, auto-select latest uploaded/updated record ---
if (empty($selected_class) || empty($selected_exam) || empty($selected_subject)) {
    $latestQuery = "
        SELECT class_code, subject, test_code 
        FROM student_score 
        WHERE teacher_id = '$teacher_id'
        ORDER BY updated_at DESC, id DESC LIMIT 1
    ";
    $latestResult = mysqli_query($con, $latestQuery);
    if ($latestResult && mysqli_num_rows($latestResult) > 0) {
        $latest = mysqli_fetch_assoc($latestResult);
        if (empty($selected_class)) $selected_class = $latest['class_code'];
        if (empty($selected_subject)) $selected_subject = $latest['subject'];
        if (empty($selected_exam)) {
            foreach ($exam_types as $key => $map) {
                if ($map['code'] == $latest['test_code']) {
                    $selected_exam = $key;
                    break;
                }
            }
        }
    }
}
?>

